  "decoder_spec": {
    "conventions": {
      "accidental_vocabulary": "class = alter + 3, so 2=FLAT, 3=NATURAL, 4=SHARP",
      "key_alter_row": "for fifths>0, the first `fifths` letters of FCGDAEB are sharp; for fifths<0, the first |fifths| of BEADGCF are flat",
      "learned_parameters": 0,
      "negative_d0": "step0 uses d0 mod 7, always in 0..6; octave0 uses floor division, so a below-middle-line note keeps its register",
      "no_labels_used": "k, is_upper and fifths are all detector/model outputs. No target, key signature or score identity is read.",
      "round": "half-to-even, matching numpy/nearest used by the corpus"
    },
    "equations": {
      "accidental": "acc0 = key_alter_row(fifths)[step0] + 3",
      "d0": "d0 = (34 if is_upper else 22) + round(2*k)",
      "midi": "midi0 = 12*(octave0+1) + SEMI[step0] + (acc0-3)",
      "octave": "octave0 = d0 // 7",
      "written_step": "step0 = LETTERS[d0 mod 7]"
    },
    "inputs": {
      "fifths": "the FROZEN V2.5 context head's key_fifths argmax, a model prediction available at inference. NOT the MusicXML key.",
      "is_upper": "the DETECTED staff role, 1.0 for the upper band. Chosen by nearest band centre, identical to the corpus builder's rule.",
      "k": "staff-relative position (bandCentreY - noteheadCentreY)/staffGap, the DETECTED band and the band-local gap (corpus 2.1). Unclipped, sign-preserving, sub-space precision."
    }
  },
