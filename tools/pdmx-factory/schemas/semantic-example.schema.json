{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corranzo.local/schemas/semantic-example-v1.json",
  "title": "Corranzo joint semantic training example",
  "type": "object",
  "required": ["schemaVersion", "exampleId", "scoreId", "semanticSourceId", "split", "input", "queries", "target", "decoderContract", "provenance"],
  "$defs": {
    "input": {
      "type": "object",
      "required": ["modelInput", "sourceTensor"],
      "properties": {
        "modelInput": {"type": "object"},
        "sourceTensor": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "number"}}
      }
    },
    "queries": {
      "type": "object",
      "required": ["objectQueries", "relationQueries", "scopeQuery"],
      "properties": {
        "objectQueries": {"type": "array"},
        "relationQueries": {"type": "array"},
        "scopeQuery": {"type": "object", "required": ["decoder", "allowAbstain"]}
      }
    },
    "target": {
      "type": "object",
      "required": ["families", "availability"],
      "properties": {
        "families": {"type": "object"},
        "availability": {"type": "object", "additionalProperties": {"type": "boolean"}}
      }
    }
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "exampleId": {"type": "string", "minLength": 1},
    "scoreId": {"type": "string", "minLength": 1},
    "semanticSourceId": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test", "future-test"]},
    "input": {"$ref": "#/$defs/input"},
    "queries": {"$ref": "#/$defs/queries"},
    "target": {"$ref": "#/$defs/target"},
    "decoderContract": {"type": "object", "required": ["id", "allowAbstain", "configurationDigest"]},
    "provenance": {"type": "object", "required": ["sourceCoordinateIdentity", "sourceTargetFirewall", "runtimeTruthInputs"]}
  },
  "additionalProperties": false
}
