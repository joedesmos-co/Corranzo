.local/

# Guitar Vision synthetic training corpus. Fully determined by the seed recorded
# in datasets/guitar-vision/synthetic/train/manifest.json, so the generated
# scores and event models are regenerated rather than committed. Committing them
# would bloat the repository while adding no information.
datasets/guitar-vision/synthetic/train/*.musicxml
datasets/guitar-vision/synthetic/train/*.events.json

# Python bytecode from read-only inspection of the Piano Vision reference stack
__pycache__/
*.pyc
tmp/guitar-vision/
tmp/gv-probe/
